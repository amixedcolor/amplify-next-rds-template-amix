{
  "name": "amplify-next-rds-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p amplify",
    "sandbox": "cross-env NODE_OPTIONS=--conditions=cdk AMPLIFY_SANDBOX=true ampx sandbox",
    "sandbox:delete": "cross-env NODE_OPTIONS=--conditions=cdk AMPLIFY_SANDBOX=true ampx sandbox delete --yes",
    "blocks:dev": "tsx watch aws-blocks/scripts/server.ts",
    "blocks:dev:stop": "tsx aws-blocks/scripts/stop.ts"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.15.7",
    "aws-amplify": "^6.22.2",
    "aws-blocks": "workspace:*",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.1",
    "@aws-amplify/backend-cli": "^1.10.0",
    "@aws-blocks/blocks": "^0.8.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "aws-cdk": "^2.1146.1",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
